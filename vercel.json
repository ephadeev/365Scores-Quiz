{
  "installCommand": "npm ci && npm ci client && npm ci server",
  "builds": [
    {
      "src": "server/package.json",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {"distDir": "dist"}
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.+)",
      "dest": "client/dist/index.html"
    }
  ]
}