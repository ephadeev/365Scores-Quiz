    "url": "https://github.com/ephadeev/365Scores-Quiz/issues"
  },
  "homepage": "https://github.com/ephadeev/365Scores-Quiz#readme",
  "workspaces": ["client", "server"],
  "description": "",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0"
  }
}
